# Records assets/demo.gif with https://github.com/charmbracelet/vhs
#   vhs demo.tape
Output assets/demo.gif

Set FontSize 15
Set Width 1200
Set Height 620
Set Theme "Catppuccin Mocha"
Set Padding 16
Set TypingSpeed 60ms

Type "diskdiet ~/code"
Enter
Sleep 3s
Down
Sleep 400ms
Space
Sleep 300ms
Space
Sleep 300ms
Type "t"
Sleep 800ms
Type "t"
Sleep 800ms
Type "a"
Sleep 1s
Type "d"
Sleep 1.5s
Type "y"
Sleep 2.5s
Type "q"
Sleep 2s
